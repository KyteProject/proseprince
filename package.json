{
  "name": "proseprince",
  "version": "0.13.0",
  "description": "Fiction-focused prose highlighting for Obsidian: parts of speech, filter words, and craft lenses inspired by King and Le Guin.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "harness": "node harness/build.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.6.5",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
